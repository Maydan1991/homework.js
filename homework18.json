	"item": [
		{
			"name": "sValidISBN13 number",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"const cheerio = require('cheerio'); \r",
							"const responseBody = pm.response.text();\r",
							"const $ = cheerio.load(responseBody);\r",
							"\r",
							"// 1. Позитивный: статус 200\r",
							"pm.test(\"Статус 200\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"// 2. Негативный: статус не 404\r",
							"pm.test(\"Статус не 404\", function () {\r",
							"    pm.response.to.not.have.status(404);\r",
							"});\r",
							"\r",
							"// 3. Позитивный: Content-Type XML\r",
							"pm.test(\"Content-Type XML\", function () {\r",
							"    pm.expect(pm.response.headers.get(\"Content-Type\")).to.match(/text\\/xml/);\r",
							"});\r",
							"\r",
							"// 4. Негативный: Content-Type не JSON\r",
							"pm.test(\"Content-Type не JSON\", function () {\r",
							"    pm.response.to.not.have.header(\"Content-Type\", /json/);\r",
							"});\r",
							"\r",
							"// 5. Позитивный: тело ответа не пустое\r",
							"pm.test(\"Response body не пустое\", function () {\r",
							"    pm.expect(responseBody).to.not.be.empty;\r",
							"});\r",
							"\r",
							"\r",
							"// 6. Негативный: в теле нет 'Internal Server Error'\r",
							"pm.test(\"Response body не содержит Internal Server Error\", function () {\r",
							"    pm.expect(responseBody).to.not.include(\"Internal Server Error\");\r",
							"});\r",
							"\r",
							"// 7. Позитивный: есть тег <IsValidISBN13Response>\r",
							"pm.test(\"Есть IsValidISBN13Response\", function () {\r",
							"    pm.expect(responseBody).to.include(\"IsValidISBN13Response\");\r",
							"});\r",
							"\r",
							"\r",
							"// 8. Позитивный: результат true/false\r",
							"pm.test(\"IsValidISBN13Result true/false\", function () {\r",
							"    const result = $(\"IsValidISBN13Result\").text();\r",
							"    pm.expect([\"true\",\"false\"]).to.include(result);\r",
							"});\r",
							"\r",
							"// 9. Негативный: тело не содержит <html>\r",
							"pm.test(\"Response body не содержит HTML\", function () {\r",
							"    pm.expect(responseBody).to.not.include(\"<html>\");\r",
							"});\r",
							"\r",
							"pm.test(\"Header Location (линк) отсутствует или не обязателен\", function () {\r",
							"    pm.expect(pm.response.headers.has(\"Location\")).to.be.oneOf([true, false]);\r",
							"});\r",
							"\r",
							""
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "text/xml; charset=utf-8",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\r\n<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\">\r\n  <soap:Body>\r\n    <IsValidISBN13 xmlns=\"http://webservices.daehosting.com/ISBN\">\r\n      <sISBN>978-1-4612-9090-2</sISBN>\r\n    </IsValidISBN13>\r\n  </soap:Body>\r\n</soap:Envelope>",
					"options": {
						"raw": {
							"language": "xml"
						}
					}
				},
				"url": {
					"raw": "http://webservices.daehosting.com/services/isbnservice.wso",
					"protocol": "http",
					"host": [
						"webservices",
						"daehosting",
						"com"
					],
					"path": [
						"services",
						"isbnservice.wso"
					]
				}
			},
			"response": []
